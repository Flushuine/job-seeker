DATABASE_URL=postgres://jobhunter:jobhunter-local@127.0.0.1:5432/jobhunter?sslmode=disable
POSTGRES_PASSWORD=jobhunter-local
# Generate with: openssl rand -hex 24
APP_TOKEN=replace-with-a-random-token-at-least-24-characters
HTTP_ADDR=127.0.0.1:8080
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
AI_ENABLED=true
AI_MAX_CONCURRENT_REQUESTS=1
# Only explicitly allowed public RSS/Atom feed hosts may be fetched.
RESEARCH_ALLOWED_HOSTS=
